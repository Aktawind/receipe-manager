  "fixed_sql": [
    {
      "name": "recipes",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"recipes\" (\"id\" TEXT NOT NULL, \"title\" TEXT NOT NULL DEFAULT '', \"description\" TEXT NOT NULL DEFAULT '', \"source\" TEXT NOT NULL DEFAULT '', \"notes\" TEXT NOT NULL DEFAULT '', \"tips\" TEXT NOT NULL DEFAULT '', \"servings\" INTEGER NULL, \"servings_unit\" TEXT NOT NULL DEFAULT '', \"prep_minutes\" INTEGER NULL, \"cook_minutes\" INTEGER NULL, \"rest_minutes\" INTEGER NULL, \"times_cooked\" INTEGER NOT NULL DEFAULT 0, \"main_photo\" TEXT NULL, \"is_favorite\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_favorite\" IN (0, 1)), \"rating\" INTEGER NULL, \"status\" TEXT NULL, \"course\" TEXT NOT NULL DEFAULT '', \"category\" TEXT NOT NULL DEFAULT '', \"collections\" TEXT NOT NULL DEFAULT '', \"equipment\" TEXT NOT NULL DEFAULT '', \"video_links\" TEXT NOT NULL DEFAULT '', \"created_at\" TEXT NOT NULL, \"updated_at\" TEXT NOT NULL, \"deleted_at\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "ingredients",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"ingredients\" (\"id\" TEXT NOT NULL, \"recipe_id\" TEXT NOT NULL REFERENCES recipes (id) ON DELETE CASCADE, \"position\" INTEGER NOT NULL, \"is_section\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_section\" IN (0, 1)), \"name\" TEXT NOT NULL DEFAULT '', \"quantity\" REAL NULL, \"unit\" TEXT NOT NULL DEFAULT '', \"note\" TEXT NOT NULL DEFAULT '', \"optional\" INTEGER NOT NULL DEFAULT 0 CHECK (\"optional\" IN (0, 1)), \"substitutes\" TEXT NOT NULL DEFAULT '', PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "recipe_steps",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"recipe_steps\" (\"id\" TEXT NOT NULL, \"recipe_id\" TEXT NOT NULL REFERENCES recipes (id) ON DELETE CASCADE, \"position\" INTEGER NOT NULL, \"title\" TEXT NOT NULL DEFAULT '', \"body\" TEXT NOT NULL DEFAULT '', PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "recipe_photos",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"recipe_photos\" (\"recipe_id\" TEXT NOT NULL REFERENCES recipes (id) ON DELETE CASCADE, \"position\" INTEGER NOT NULL, \"file\" TEXT NOT NULL, PRIMARY KEY (\"recipe_id\", \"position\"));"
        }
      ]
    },
    {
      "name": "recipe_links",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"recipe_links\" (\"recipe_id\" TEXT NOT NULL REFERENCES recipes (id) ON DELETE CASCADE, \"position\" INTEGER NOT NULL, \"linked_recipe_id\" TEXT NOT NULL, PRIMARY KEY (\"recipe_id\", \"position\"));"
        }
      ]
    }
  ]
